{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleEvent",
  "description": "Durable accepted transition/event. Transition legality, new_revision=expected_revision+1, aggregate ordering and authentication are application obligations. An activity failure records no successful promotion.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "event_type": {
      "enum": [
        "report_accepted",
        "investigation_assigned",
        "proposal_registered",
        "development_authorized",
        "bundle_built",
        "validation_started",
        "validation_recorded",
        "approval_recorded",
        "staging_recorded",
        "deployment_committed",
        "recovery_requested",
        "recovery_committed",
        "candidate_terminated",
        "activity_failed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_principal_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "aggregate_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "aggregate_kind": {
      "enum": [
        "proposal",
        "deployment",
        "report"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "new_revision": {
      "type": "integer",
      "minimum": 1
    },
    "from_state": {
      "anyOf": [
        {
          "enum": [
            "REPORTED",
            "INVESTIGATING",
            "PROPOSED",
            "BUILD_AUTHORIZED",
            "BUILT",
            "VALIDATING",
            "VALIDATED",
            "APPROVED",
            "STAGED",
            "ACTIVE",
            "RETIRED",
            "ROLLBACK_PENDING",
            "REJECTED",
            "WITHDRAWN",
            "SUPERSEDED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "to_state": {
      "enum": [
        "REPORTED",
        "INVESTIGATING",
        "PROPOSED",
        "BUILD_AUTHORIZED",
        "BUILT",
        "VALIDATING",
        "VALIDATED",
        "APPROVED",
        "STAGED",
        "ACTIVE",
        "RETIRED",
        "ROLLBACK_PENDING",
        "REJECTED",
        "WITHDRAWN",
        "SUPERSEDED"
      ]
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "causation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "payload": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "bundle_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "semantic_snapshot_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "approval": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "producer_principal_id",
    "domain_id",
    "aggregate_id",
    "aggregate_kind",
    "expected_revision",
    "new_revision",
    "from_state",
    "to_state",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "payload"
  ],
  "additionalProperties": false
}
