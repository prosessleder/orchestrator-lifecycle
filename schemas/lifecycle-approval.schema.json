{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleApproval",
  "description": "Approval receipt from an independent issuer. Consumers check issuer authenticity, time, scope, exact digest/base/revision and independently issued grants. Development approval cannot authorize production deployment.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "approval_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "approval_kind": {
      "enum": [
        "development",
        "production",
        "recovery"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "issuer_principal_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "domain_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    },
    "candidate": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "candidate_kind": {
      "enum": [
        "semantic_snapshot",
        "operating_bundle"
      ]
    },
    "base_bundle_digest": {
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "expected_control_revision": {
      "type": "integer",
      "minimum": 0
    },
    "gate_policy": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ArtifactRef"
      },
      "minItems": 0
    },
    "authority_delta": {
      "$ref": "common.schema.json#/$defs/AuthorityDelta"
    },
    "authorized_grants": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Grant"
      },
      "minItems": 0
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "decision": {
      "const": "approved"
    },
    "decision_record": {
      "$ref": "common.schema.json#/$defs/ArtifactRef"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/Identifier"
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "approval_kind",
    "issued_at",
    "valid_until",
    "issuer_principal_id",
    "domain_id",
    "candidate",
    "candidate_kind",
    "base_bundle_digest",
    "expected_control_revision",
    "gate_policy",
    "evidence",
    "authority_delta",
    "authorized_grants",
    "scope",
    "budget",
    "decision",
    "decision_record",
    "correlation_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_kind": {
            "enum": [
              "production",
              "recovery"
            ]
          }
        },
        "required": [
          "approval_kind"
        ]
      },
      "then": {
        "properties": {
          "candidate_kind": {
            "const": "operating_bundle"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_kind": {
            "const": "development"
          }
        },
        "required": [
          "approval_kind"
        ]
      },
      "then": {
        "properties": {
          "candidate_kind": {
            "const": "semantic_snapshot"
          }
        }
      }
    }
  ]
}
